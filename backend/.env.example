# Copia este archivo a ".env" y completa los valores reales. Nunca subas el ".env" a git.

# --- OpenAI ---
OPENIA_API_KEY=sk-tu-api-key-de-openai

# --- Pinecone ---
PINECONE_API_KEY=tu-api-key-de-pinecone
PINECONE_INDEX_NAME=asistente-jnj
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Si usas un índice ya existente, esta dimensión debe coincidir con la suya (se crea
# automáticamente con esta dimensión solo si el índice no existe todavía).
OPENAI_EMBEDDING_DIMENSION=1536

# --- SQLiteCloud ---
# Formato: sqlitecloud://HOST:PORT/DATABASE?apikey=TU_API_KEY
CADENA_SQLITECLOUD=sqlitecloud://tu-host.sqlite.cloud:8860/tu-base.sqlite?apikey=tu-api-key

# --- Servidor ---
PORT=3000
CORS_ORIGINS=http://localhost:4200
